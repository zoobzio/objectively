{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "inputs": ["src/**", "build.config.ts", "tsconfig.json", "package.json"],
      "outputs": [".dist/**"]
    },
    "typecheck": {
      "inputs": ["src/**", "test/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "test/**", "*.ts", ".oxlintrc.json", "package.json"],
      "outputs": []
    },
    "fmt:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", "test/**", "vitest.config.ts", "tsconfig.json", "package.json"],
      "env": ["NODE_VERSION"],
      "outputs": []
    },
    "coverage": {
      "inputs": ["src/**", "test/**", "vitest.config.ts", "tsconfig.json", "package.json"],
      "env": ["NODE_VERSION"],
      "outputs": [".coverage/**"]
    }
  }
}
