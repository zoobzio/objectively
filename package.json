{
  "name": "objectively",
  "version": "0.1.2",
  "description": "Small, dependency-free, strongly typed object helpers and type guards.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/objectively.git"
  },
  "files": [
    ".dist"
  ],
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@vitest/coverage-v8": "^5.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.7.0",
    "unbuild": "^3.5.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.27.0"
}
